{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triton-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "vars": {
    "MAX_UPLOAD_BYTES": "100000000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "triton",
      "database_id": "your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "triton-files"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
